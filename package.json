{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3003 --host=0.0.0.0",
    "dev:apps": "concurrently -k -n pc,mobile -c blue,green \"npm run dev\" \"npm run dev --prefix mobile\"",
    "dev:stack": "concurrently -k -n pc,mobile,proxy -c blue,green,magenta \"npm run dev\" \"npm run dev --prefix mobile\" \"node dev/stack-proxy.cjs\"",
    "dev:stack:docker": "concurrently -k -n pc,mobile,proxy -c blue,green,magenta \"npm run dev\" \"npm run dev --prefix mobile\" \"docker compose -f dev/docker-compose.stack.yml up\"",
    "build": "vite build",
    "build:site": "npm run build && (cd mobile && npm run build) && mkdir -p dist/m && rm -rf dist/m/* && cp -a mobile/dist/. dist/m/",
    "preview": "vite preview",
    "deploy": "bash ./deploy.sh",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p mobile/tsconfig.json"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.81",
    "@studio-freight/hamo": "^0.6.33",
    "@studio-freight/lenis": "^1.0.42",
    "@tabler/icons-react": "^3.31.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "barba.js": "^1.0.0",
    "chart.js": "4.4.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "i18next": "^26.0.8",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "motion": "^12.38.0",
    "ogl": "^1.0.11",
    "pixi.js": "^8.18.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.6",
    "react-intersection-observer": "^10.0.3",
    "react-router-dom": "^7.14.1",
    "split-type": "^0.3.4",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "tsparticles": "^3.9.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "http-proxy": "^1.18.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
